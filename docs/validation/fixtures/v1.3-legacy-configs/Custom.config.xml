<Configuration>
  <Meta>
    <PreferUserConfiguration>false</PreferUserConfiguration>
  </Meta>
  <Application>
    <Start>
      <CheckForUpdate>false</CheckForUpdate>
    </Start>
  </Application>
  <Custom>
    <Item>
      <Key>KeeFetch.FetchPresetMode</Key>
      <Value>Custom</Value>
    </Item>
    <Item>
      <Key>KeeFetch.HasSeenFirstRunDisclosure</Key>
      <Value>True</Value>
    </Item>
    <Item>
      <Key>KeeFetch.ProviderOrder</Key>
      <Value>Direct Site,Yandex,Google,Twenty Icons,DuckDuckGo,Favicone,Icon Horse</Value>
    </Item>
    <Item>
      <Key>KeeFetch.EnableYandexProvider</Key>
      <Value>False</Value>
    </Item>
    <Item>
      <Key>KeeFetch.EnableGoogleProvider</Key>
      <Value>True</Value>
    </Item>
    <Item>
      <Key>KeeFetch.Timeout</Key>
      <Value>13</Value>
    </Item>
    <Item>
      <Key>KeeFetch.AllowSyntheticFallbacks</Key>
      <Value>False</Value>
    </Item>
    <Item>
      <Key>KeeFetch.AllowSelfSignedCerts</Key>
      <Value>True</Value>
    </Item>
    <Item>
      <Key>KeeFetch.UseThirdPartyFallbacks</Key>
      <Value>True</Value>
    </Item>
  </Custom>
</Configuration>